
import java.util.*;

/**
 * LeetCode 21 - Merge Two Sorted Lists
 *
 * Problem in plain English:
 * Given two sorted linked lists, merge them into one sorted linked list.
 *
 * Examples:
 * Input: [1,2,4], [1,3,4] -> Output: [1,1,2,3,4,4]
 * Input: [], [] -> Output: []
 * Input: [], [0] -> Output: [0]
 *
 * Constraints:
 * Number of nodes in both lists is in range [0, 100].
 * Node values are between -100 and 100.
 *
 * Edge cases:
 * Empty lists, one empty list, duplicates, negatives, single node.
 *
 * Pattern: Linked List + Two Pointers.
 *
 * Complexity Table
 * Brute Force (copy + sort): O((m+n)log(m+n)) time, O(m+n) space.
 * Optimal (iterative merge): O(m+n) time, O(1) extra space excluding output.
 */
public class MergeTwoSortedListsLC21 {

    static class ListNode {
        int val; ListNode next;
        ListNode(int v){ val=v; }
    }

    static ListNode build(int[] arr){
        ListNode d=new ListNode(0), c=d;
        for(int x:arr){ c.next=new ListNode(x); c=c.next; }
        return d.next;
    }

    static String print(ListNode h){
        StringBuilder sb=new StringBuilder("[");
        while(h!=null){
            sb.append(h.val);
            h=h.next;
            if(h!=null) sb.append(", ");
        }
        return sb.append("]").toString();
    }

    /**
     * Naive idea:
     * Copy all values, sort them, then rebuild a linked list.
     * Correct because sorting all elements gives the required order.
     * Slow because sorting costs O(n log n) even though inputs are already sorted.
     */
    static ListNode mergeBruteForce(ListNode l1,ListNode l2){
        List<Integer> vals=new ArrayList<>();
        while(l1!=null){ vals.add(l1.val); l1=l1.next; }
        while(l2!=null){ vals.add(l2.val); l2=l2.next; }
        Collections.sort(vals); // Extra work compared with optimal merge.

        ListNode d=new ListNode(0), c=d;
        for(int v:vals){
            c.next=new ListNode(v);
            c=c.next;
        }
        return d.next;
    }

    /**
     * Key insight:
     * Since both lists are already sorted, compare current nodes and take the smaller.
     * Each node is visited once, giving linear time.
     */
    static ListNode mergeOptimal(ListNode l1,ListNode l2){
        ListNode dummy=new ListNode(-1), tail=dummy;

        while(l1!=null && l2!=null){
            if(l1.val<=l2.val){
                tail.next=l1; // Safe because l1 is smaller.
                l1=l1.next;
            }else{
                tail.next=l2;
                l2=l2.next;
            }
            tail=tail.next;
        }

        // Attach remaining nodes.
        tail.next=(l1!=null)?l1:l2;
        return dummy.next;
    }

    public static void main(String[] args){
        int[][] a={{1,2,4},{},{-3,-1,2},{5}};
        int[][] b={{1,3,4},{0},{-2,2,3},{}};

        for(int i=0;i<a.length;i++){
            System.out.println("Case "+(i+1));
            System.out.println("Brute Force: "+print(mergeBruteForce(build(a[i]),build(b[i]))));
            System.out.println("Optimal    : "+print(mergeOptimal(build(a[i]),build(b[i]))));
            System.out.println();
        }
    }
}

/*
Recognize this pattern when two sorted inputs must be combined while preserving order.
Common follow-up: merge K sorted lists -> use divide and conquer or a min heap.
*/